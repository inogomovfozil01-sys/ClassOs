# Local SQLite database. Prisma schema currently uses SQLite.
DATABASE_URL="file:./dev.db"
# Reserve a unique random value for deployments; never commit real secrets.
AUTH_SECRET=""
# Optional: required for Gemini / JARVIS features.
GEMINI_API_KEY=""
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
